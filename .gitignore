# Repository-wide allowlist: documentation and reusable source only.
*
!/.gitignore
!/README.md
!/LICENSE
!/AGENTS.md
!/scripts/
!/scripts/*.py
!/ai-auto-video/
!/ai-auto-video/SKILL.md
!/ai-auto-video/agents/
!/ai-auto-video/agents/openai.yaml
!/ai-auto-video/references/
!/ai-auto-video/references/*.md
!/ai-auto-video/scripts/
!/ai-auto-video/scripts/*.py
!/ai-auto-video/scripts/requirements*.txt
# Never allow credentials, private configuration, caches or generated media.
.env*
*.env
*credentials*
*secrets*
*.pem
*.key
*.p12
*.pfx
.DS_Store
__pycache__/
*.pyc
